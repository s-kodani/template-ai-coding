# アプリ Postgres
POSTGRES_USER=knowledge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=knowledge
# Docker 内サービス用（compose が mcp-server 向けに上書き）。ホストからの seed は POSTGRES_* + localhost:5433 を使用。
DATABASE_URL=postgresql://knowledge:change-me@postgres:5432/knowledge

# OpenAI 互換 API（embedding + チャット LLM）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CHAT_MODEL=gpt-4o-mini

# MCP サーバー
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_PATH=/mcp
MCP_BEARER_TOKEN=
FASTMCP_STATELESS_HTTP=true
FASTMCP_TELEMETRY_MODE=native
MCP_JWKS_URI=http://localhost:8081/realms/knowledge/protocol/openid-connect/certs
MCP_ISSUER=http://localhost:8081/realms/knowledge
MCP_AUDIENCE=http://localhost:8000/mcp
MCP_AUTHORIZATION_SERVER=http://localhost:8081/realms/knowledge
MCP_RESOURCE_BASE_URL=http://localhost:8000

# Chainlit
CHAINLIT_HOST=0.0.0.0
CHAINLIT_PORT=8080
CHAINLIT_URL=http://localhost:8080
CHAINLIT_AUTH_SECRET=chainlit-local-auth-secret-change-me
MCP_SERVER_URL=http://mcp-server:8000/mcp
MCP_GATEWAY_URL=http://localhost:8082
TOKEN_STORE_DATABASE_URL=postgresql://knowledge:change-me@localhost:5433/knowledge
TOKEN_STORE_KEY=chainlit-token-store-key-change-me

# Keycloak（ローカル IdP。make -C infra up で起動。本番秘密ではない）
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
OAUTH_GENERIC_CLIENT_ID=chainlit
OAUTH_GENERIC_CLIENT_SECRET=chainlit-local-secret
OAUTH_GENERIC_AUTH_URL=http://localhost:8081/realms/knowledge/protocol/openid-connect/auth
OAUTH_GENERIC_TOKEN_URL=http://localhost:8081/realms/knowledge/protocol/openid-connect/token
OAUTH_GENERIC_USER_INFO_URL=http://localhost:8081/realms/knowledge/protocol/openid-connect/userinfo
OAUTH_GENERIC_SCOPES=openid profile email
OAUTH_GENERIC_NAME=keycloak
OAUTH_GENERIC_USER_IDENTIFIER=email
# Chainlit 組み込み Keycloak provider と id が衝突しないようにする
OAUTH_KEYCLOAK_NAME=unused
GATEWAY_CLIENT_SECRET=mcp-gateway-local-secret

# Langfuse（UI でキー作成するまで任意）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_TRACING_ENABLED=true

# タイムアウト（秒）
EMBEDDING_TIMEOUT=30
DB_TIMEOUT=10

# Langflow（任意。make -C infra langflow-up。デフォルトの make up には含まれない）
LANGFLOW_AUTO_LOGIN=true
LANGFLOW_URL=http://localhost:7860
# UI で発行したキー。Git / Flow / compose には置かない。未設定時は auto_login を試す。
LANGFLOW_API_KEY=
LANGFLOW_FLOW_ID=
LANGFLOW_FLOW_NAME=Ingest
# ホストから Langflow 専用 DB を読む adapter 用。SearchService は使わない。
LANGFLOW_VECTORS_URL=postgresql://langflow:langflow@localhost:5434/langflow_vectors
LANGFLOW_COLLECTION_NAME=knowledge_documents_v1
