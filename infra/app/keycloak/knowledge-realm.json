{
  "realm": "knowledge",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "mcp-reader",
        "description": "Call knowledge-mcp search tools",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "clientScopes": [
    {
      "name": "chainlit-mcp-gateway",
      "description": "Include mcp-gateway as audience on Chainlit access tokens",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "mcp-gateway-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "mcp-gateway",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "mcp-tools",
      "description": "MCP tool invocation bound to knowledge-mcp resource",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "knowledge-mcp-resource",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "http://localhost:8000/mcp",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "chainlit",
      "name": "Chainlit",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "chainlit-local-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8080/auth/oauth/keycloak/callback",
        "http://127.0.0.1:8080/auth/oauth/keycloak/callback"
      ],
      "webOrigins": [
        "http://localhost:8080",
        "http://127.0.0.1:8080"
      ],
      "attributes": {
        "pkce.code.challenge.method": ""
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email",
        "chainlit-mcp-gateway"
      ],
      "optionalClientScopes": [
        "offline_access",
        "address",
        "phone",
        "microprofile-jwt"
      ]
    },
    {
      "clientId": "mcp-gateway",
      "name": "MCP Gateway",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "mcp-gateway-local-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "attributes": {
        "standard.token.exchange.enabled": "true",
        "pkce.code.challenge.method": ""
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "mcp-tools"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "knowledge-mcp",
      "name": "knowledge-mcp",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "knowledge-mcp-local-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "attributes": {
        "pkce.code.challenge.method": ""
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "mcp-tools"
      ],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "dev",
      "enabled": true,
      "email": "dev@localhost",
      "emailVerified": true,
      "firstName": "Dev",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "dev",
          "temporary": false
        }
      ],
      "realmRoles": ["mcp-reader", "default-roles-knowledge"]
    },
    {
      "username": "readerless",
      "enabled": true,
      "email": "readerless@localhost",
      "emailVerified": true,
      "firstName": "No",
      "lastName": "Reader",
      "credentials": [
        {
          "type": "password",
          "value": "readerless",
          "temporary": false
        }
      ],
      "realmRoles": ["default-roles-knowledge"]
    }
  ]
}
