FROM node:22-slim AS app-ui
WORKDIR /build/apps/knowledge-search
COPY apps/knowledge-search/package*.json ./
RUN npm ci
COPY apps/knowledge-search ./
RUN npm run build

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app

RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock README.md ./
COPY src ./src
COPY scripts ./scripts
COPY --from=app-ui /build/src/knowledge_mcp/static/search-results.html ./src/knowledge_mcp/static/search-results.html
COPY infra/app/keycloak/knowledge-realm.json ./infra/app/keycloak/knowledge-realm.json

RUN uv sync --frozen --no-dev --no-editable

EXPOSE 8000

CMD ["python", "-m", "knowledge_mcp.server"]
